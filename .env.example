# Meta App Credentials
NEXT_PUBLIC_META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Meta Graph API Version
NEXT_PUBLIC_META_GRAPH_VERSION=v20.0

# WhatsApp Embedded Signup v4 Configuration
# Created in Meta Business Manager under Solution Configs
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=your_whatsapp_config_id_here

# System User Access Token / Tech Provider Permanent Token (Optional for administrative Graph API actions)
META_SYSTEM_USER_TOKEN=your_system_user_token_here

# Instagram Business OAuth Settings
NEXT_PUBLIC_INSTAGRAM_REDIRECT_URI=http://localhost:3000/instagram/callback

# Backend / API Base URL (if separate from Next.js server)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
