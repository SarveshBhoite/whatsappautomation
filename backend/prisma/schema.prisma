model Appointment {
  id                     String                @id @default(uuid())
  organizationId         String
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversationId         String?
  customerPhone          String?
  customerName           String
  customerEmail          String?
  title                  String
  description            String?
  startTime              DateTime
  endTime                DateTime
  timezone               String                @default("Asia/Kolkata")
  status                 String                @default("CONFIRMED") // CONFIRMED, RESCHEDULED, CANCELLED
  googleAccountId        String?
  googleCalendarConfig   GoogleCalendarConfig? @relation(fields: [googleAccountId], references: [id], onDelete: SetNull)
  googleCalendarId       String?
  googleCalendarEventId  String?
  googleMeetUrl          String?
  googleMeetConferenceId String?
  googleEventHtmlLink    String?
  googleSyncStatus       String?               @default("PENDING") // PENDING, SYNCED, FAILED, AUTH_REQUIRED
  googleSyncError        String?
  notificationSent       Boolean               @default(false)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([organizationId])
  @@index([customerPhone])
  @@map("appointments")
}

