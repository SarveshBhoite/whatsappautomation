generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                  String                 @id @default(uuid())
  name                String
  enabledModules      String[]               @default(["whatsapp", "instagram", "gmb", "gmail", "linkedin", "youtube", "google_ads", "meta_ads", "reviews", "ai_agent", "tools"])
  status              String                 @default("ACTIVE")
  createdAt           DateTime               @default(now())
  users               User[]
  waConfigs           WhatsAppConfig[]
  igConfigs           InstagramConfig[]
  ytConfigs           YouTubeConfig[]
  gmbConfigs          GoogleBusinessConfig[]
  linkedInConfig      LinkedInConfig?
  linkedInPosts       LinkedInPost[]
  linkedInSchedules   LinkedInSchedule[]
  aiContentHistories  AIContentHistory[]
  gmailConfigs        GmailConfig[]
  gmailAutoReplyRules GmailAutoReplyRule[]
  flows               Flow[]
  conversations       Conversation[]
  googleReviews       GoogleReview[]
  googlePosts         GooglePost[]
  googleQuestions     GoogleQuestion[]
  googleAdCampaigns   GoogleAdCampaign[]
  googleAdAccounts    GoogleAdAccount[]
  aiAgentConfig       AiAgentConfig?
  aiKnowledgeItems    AiKnowledgeItem[]
  aiCapturedLeads     AiCapturedLead[]
  metaAdConfig        MetaAdConfig?
  metaAdAccounts      MetaAdAccount[]
  metaAdCampaigns     MetaAdCampaign[]
  whatsappDripCampaigns WhatsAppDripCampaign[]
  instagramCommentAutomations InstagramCommentAutomation[]
  apiKeys             ApiKey[]
  googleCalendarConfigs GoogleCalendarConfig[]
  appointments        Appointment[]
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  name           String?
  password       String?      @default("admin123")
  role           String       @default("agent")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model WhatsAppConfig {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  phoneNumberId      String
  phoneNumber        String?
  accountName        String?
  wabaId             String
  accessToken        String
  webhookVerifyToken String       @default(uuid())
  isDefault          Boolean      @default(false)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
}

model InstagramConfig {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  pageId             String
  instagramAccountId String
  username           String?
  name               String?
  profilePic         String?
  pageAccessToken    String
  webhookVerifyToken String       @default(uuid())
  isDefault          Boolean      @default(false)
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId])
}

model YouTubeConfig {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  channelId      String
  channelTitle   String?
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  isDefault      Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model LinkedInConfig {
  id                 String           @id @default(uuid())
  organizationId     String           @unique
  authorUrn          String?          @default("")
  companyId          String?
  companyName        String?
  memberId           String?
  memberName         String?
  memberEmail        String?
  memberPicture      String?
  headline           String?
  vanityName         String?
  companyLogo        String?
  website            String?
  industry           String?
  description        String?
  webhookVerifyToken String           @default(uuid())
  expiresIn          Int?
  organization       Organization     @relation(fields: [organizationId], references: [id])
  profile            LinkedInProfile?
  accessToken        String
  refreshToken       String?
  tokenExpiry        DateTime?
  expiresAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model LinkedInProfile {
  id             String          @id @default(uuid())
  organizationId String          @unique
  configId       String?         @unique
  linkedInConfig LinkedInConfig? @relation(fields: [configId], references: [id])
  authorUrn      String?         @default("")
  memberId       String?
  name           String?
  email          String?
  picture        String?
  headline       String?
  locale         String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model LinkedInSyncLog {
  id             String   @id @default(uuid())
  organizationId String
  action         String?  @default("SYNC")
  event          String?
  status         String
  details        String?
  timestamp      DateTime @default(now())
  createdAt      DateTime @default(now())
}

model LinkedInPost {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  postId         String       @default(uuid()) @unique
  linkedinPostId String?      @unique
  authorUrn      String?      @default("")
  author         String?
  commentary     String?      @default("")
  summary        String?
  mediaUrl       String?
  mediaType      String?      @default("NONE")
  visibility     String?      @default("PUBLIC")
  lifecycleState String?      @default("PUBLISHED")
  publishedAt    DateTime?    @default(now())
  likesCount     Int?         @default(0)
  commentsCount  Int?         @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now())
}

model LinkedInPersonalPost {
  id             String    @id @default(uuid())
  organizationId String
  linkedinPostId String?   @unique
  authorUrn      String?   @default("")
  author         String?
  text           String?   @default("")
  summary        String?
  mediaUrl       String?
  publishedAt    DateTime? @default(now())
  likesCount     Int?      @default(0)
  commentsCount  Int?      @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now())
}

model LinkedInSchedule {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  summary         String
  mediaUrl        String?
  scheduledAt     DateTime?
  status          String       @default("SCHEDULED")
  approvalStatus  String?      @default("APPROVED")
  approvedBy      String?
  rejectionReason String?
  retryCount      Int          @default(0)
  errorMessage    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model AIContentHistory {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  userId           String?
  prompt           String
  generatedContent String
  generatedText    String?
  mode             String       @default("Post Generator")
  tone             String?
  model            String       @default("Groq-openai/gpt-oss-120b")
  modelName        String?      @default("Groq-openai/gpt-oss-120b")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  @@map("ai_content_histories")
}

model InstagramCommentAutomation {
  id                    String                    @id @default(uuid())
  organizationId        String
  organization          Organization              @relation(fields: [organizationId], references: [id])
  name                  String
  mediaId               String
  mediaType             String                    @default("POST") // REEL, POST, ALL
  mediaUrl              String?
  mediaCaption          String?
  keywords              String[]                  // e.g. ["PDF", "GUIDE", "LINK"]
  matchingMode          String                    @default("CONTAINS") // EXACT, CONTAINS, WHOLE_WORD, STARTS_WITH, ENDS_WITH, PHRASE, PATTERN
  privateMessageTemplate String
  documentUrl           String?
  documentName          String?
  enablePublicReply     Boolean                   @default(true)
  publicReplyTemplate   String?                   @default("Thanks @{username}! Check your DMs for the link 📩")
  status                String                    @default("ACTIVE") // ACTIVE, PAUSED, INACTIVE
  commentsCount         Int                       @default(0)
  matchesCount          Int                       @default(0)
  dmsSentCount          Int                       @default(0)
  lastTriggeredAt       DateTime?

  // Extended Production Automation Engine Parameters
  instagramAccountId    String?                   @default("ALL")
  triggerType           String                    @default("SPECIFIC_KEYWORD") // ANY_COMMENT, SPECIFIC_KEYWORD, EXACT_COMMENT, PHRASE_MATCH, MULTIPLE_KEYWORDS, PATTERN_MATCH
  triggerPhrases        String[]                  @default([])
  exactMatchText        String?
  partialMatchText      String?
  isCaseSensitive       Boolean                   @default(false)
  matchBehavior         String                    @default("ANY") // ANY, ALL
  excludedKeywords      String[]                  @default([])
  excludedPhrases       String[]                  @default([])
  targetPostSelection   String                    @default("SPECIFIC") // ALL, SPECIFIC, MULTIPLE, FUTURE
  targetPostIds         String[]                  @default([])
  postFilter            Json?
  responseAction        String                    @default("BOTH") // PUBLIC_REPLY, PRIVATE_MESSAGE, BOTH, MULTIPLE
  publicReplyConfig     Json?
  privateMessageConfig  Json?
  actions               Json?
  delayConfig           Json?
  limitsConfig          Json?
  duplicatePrevention   Json?
  cooldownConfig        Json?
  scheduleConfig        Json?
  priority              Int                       @default(10)
  conflictPolicy        String                    @default("HIGHEST_PRIORITY_ONLY") // EXECUTE_ALL, HIGHEST_PRIORITY_ONLY, FIRST_MATCHING, HIGHEST_PRIORITY_AND_STOP
  errorHandlingConfig   Json?
  isTestMode            Boolean                   @default(false)
  normalizationConfig   Json?
  userConditionsConfig  Json?
  commentConditionsConfig Json?

  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  auditLogs             InstagramCommentAuditLog[]
  queueItems            InstagramActionQueueItem[]

  @@map("instagram_comment_automations")
}

model InstagramCommentAuditLog {
  id                    String                     @id @default(uuid())
  organizationId        String
  automationId          String
  automation            InstagramCommentAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  commentId             String                     @unique
  mediaId               String
  commenterUser         String
  commenterId           String?
  commentText           String
  matchedKeyword        String
  matchedPhrase         String?
  matchedCondition      String?
  documentSent          String?
  publicReplySent       String?
  privateDmSent         Boolean                    @default(false)
  status                String                     @default("SUCCESS") // RECEIVED, MATCHED, NOT_MATCHED, QUEUED, PROCESSING, SUCCESS, COMPLETED, PARTIALLY_COMPLETED, FAILED, SKIPPED, RATE_LIMITED, CANCELLED
  actionStatuses        Json?
  errorMessage          String?
  errorCode             String?
  skipReason            String?
  retryCount            Int                        @default(0)
  processingDurationMs  Int?
  metaResponseMetadata  Json?
  createdAt             DateTime                   @default(now())

  @@map("instagram_comment_audit_logs")
}

model InstagramActionQueueItem {
  id             String                     @id @default(uuid())
  organizationId String
  automationId   String
  automation     InstagramCommentAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  commentId      String
  mediaId        String
  commenterUser  String
  commenterId    String?
  commentText    String
  matchedKeyword String?
  actionId       String
  actionType     String                     // PUBLIC_REPLY, PRIVATE_MESSAGE, LOG_ACTIVITY, UPDATE_STATS
  actionConfig   Json
  actionOrder    Int                        @default(1)
  scheduledFor   DateTime                   @default(now())
  attempts       Int                        @default(0)
  maxAttempts    Int                        @default(3)
  status         String                     @default("QUEUED") // QUEUED, PROCESSING, COMPLETED, FAILED, RETRYING, CANCELLED
  lastError      String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@map("instagram_action_queue_items")
}

model GmailConfig {
  id                String         @id @default(uuid())
  organizationId    String
  displayName       String?
  emailAddress      String
  accessToken       String
  refreshToken      String?
  tokenExpiresAt     DateTime?
  historyId         String?
  autoReplyTemplate String?
  autoReplyEnabled  Boolean        @default(true)
  isAutoReplyOn     Boolean        @default(true)
  isDefault         Boolean        @default(false)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  organization      Organization   @relation(fields: [organizationId], references: [id])
  gmailThreads      GmailThread[]
  gmailMessages     GmailMessage[]

  @@index([organizationId])
}

model GmailThread {
  id             String         @id @default(uuid())
  organizationId String
  gmailConfigId  String?
  gmailConfig    GmailConfig?   @relation(fields: [gmailConfigId], references: [id], onDelete: Cascade)
  threadId       String         @unique
  subject        String?
  snippet        String?
  sender         String?
  label          String?
  historyId      String?
  isStarred      Boolean        @default(false)
  isSpam         Boolean        @default(false)
  status         String         @default("ACTIVE")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  messages       GmailMessage[]
}

model GmailMessage {
  id             String            @id @default(uuid())
  organizationId String?
  gmailConfigId  String?
  gmailConfig    GmailConfig?      @relation(fields: [gmailConfigId], references: [id], onDelete: Cascade)
  threadId       String
  thread         GmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messageId      String            @unique
  from           String?           @default("")
  to             String?           @default("")
  subject        String?
  snippet        String?
  content        String?
  bodyText       String?
  bodyHtml       String?
  htmlContent    String?
  aiDraft        String?
  sender         String?
  direction      String            @default("INBOUND")
  internalDate   DateTime          @default(now())
  attachments    GmailAttachment[]
  createdAt      DateTime          @default(now())
}

model GmailAttachment {
  id           String       @id @default(uuid())
  attachmentId String?
  messageId    String
  gmailMessage GmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename     String?
  mimeType     String?
  size         Int?
  data         String?
  createdAt    DateTime     @default(now())
}

model GmailAutoReplyRule {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  keyword        String
  replyTemplate  String?      @default("")
  replyText      String?
  fileUrl        String?
  fileName       String?
  mimeType       String?
  useAiDraft     Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model GoogleBusinessConfig {
  id                  String       @id @default(uuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  accountId           String       @default("")
  locationId          String       @default("")
  googleLocationId    String?
  googlePlaceId       String?
  googleRefreshToken  String?
  googleReviewUrl     String?
  googleAdsCustomerId String?
  googleClientId      String?
  googleClientSecret  String?
  autoReplyEnabled    Boolean      @default(false)
  autoReplyTemplate   String?
  autoReplyMinRating  Int?         @default(4)
  accountName         String?
  locationName        String?
  accessToken         String       @default("")
  refreshToken        String?
  tokenExpiresAt      DateTime?
  isDefault           Boolean      @default(false)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId])
}

model GoogleReview {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  accountId      String?
  reviewId       String             @default(uuid())
  reviewerName   String             @default("Customer")
  customerName   String?
  reviewerPhoto  String?
  starRating     String             @default("5")
  rating         Int?
  comment        String?
  replyText      String?
  replyStatus    String?            @default("NO_REPLY")
  source         String?
  status         String?            @default("ACTIVE")
  createTime     DateTime           @default(now())
  updateTime     DateTime           @default(now())
  reviewReply    GoogleReviewReply?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model GoogleReviewReply {
  id           String       @id @default(uuid())
  reviewId     String       @unique
  googleReview GoogleReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  comment      String
  updateTime   DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model GooglePost {
  id               String       @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  accountId        String?
  name             String?      @unique
  summary          String
  topicType        String       @default("STANDARD")
  callToAction     String?
  callToActionType String?
  callToActionUrl  String?
  actionUrl        String?
  mediaUrl         String?      @default("")
  mediaFormat      String?      @default("PHOTO")
  state            String       @default("LIVE")
  status           String       @default("LIVE")
  scheduledAt      DateTime?
  gmbPostId        String?      @unique
  retryCount       Int          @default(0)
  createTime       DateTime     @default(now())
  updateTime       DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model GoogleQuestion {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  accountId      String?
  name           String         @default(uuid())
  gmbQuestionId  String?        @unique
  authorName     String         @default("User")
  authorPhoto    String?
  text           String
  answerText     String?
  status         String?        @default("ACTIVE")
  upvoteCount    Int            @default(0)
  createTime     DateTime       @default(now())
  updateTime     DateTime       @default(now())
  answers        GoogleAnswer[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model GoogleAnswer {
  id             String         @id @default(uuid())
  questionId     String
  question       GoogleQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  name           String?        @unique
  authorName     String
  authorPhoto    String?
  text           String
  upvoteCount    Int            @default(0)
  createTime     DateTime
  updateTime     DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Flow {
  id             String       @id @default(uuid())
  name           String
  description    String?
  category       String?      @default("GENERAL")
  platform       String       @default("whatsapp")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  flowGraph      Json?        @default("{}")
  graphJson      Json?
  status         String?      @default("ACTIVE")
  isActive       Boolean      @default(false)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Conversation {
  id             String       @id @default(uuid())
  customerPhone  String
  customerName   String?
  platform       String       @default("whatsapp")
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  phoneNumberId  String?
  accountHandle  String?
  currentStepId  String?
  currentNodeId  String?
  flowState      Json?
  isBotPaused    Boolean      @default(false)
  botPausedUntil DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  messages       Message[]

  @@index([organizationId, phoneNumberId])
  @@index([organizationId, platform])
}

model Message {
  id              String        @id @default(uuid())
  conversationId  String
  conversation    Conversation  @relation(fields: [conversationId], references: [id])
  direction       String
  messageType     String        @default("text")
  content         String
  mediaMimeType   String?       // MIME type for media messages (image/jpeg, application/pdf, etc.)
  mediaUrl        String?       // Accessible public URL or ImageKit URL of the media file
  waMessageId     String?       @unique
  status          String        @default("delivered")
  senderName      String?
  quotedMessageId String?
  quotedMessage   Message?      @relation("QuotedReplies", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  replyMessages   Message[]     @relation("QuotedReplies")
  createdAt       DateTime      @default(now())
}

model GoogleAdAccount {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  customerId      String
  name            String?
  descriptiveName String?
  currencyCode    String       @default("USD")
  timeZone        String       @default("UTC")
  isManager       Boolean      @default(false)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, customerId])
}

model GoogleAdCampaign {
  id                     String       @id @default(uuid())
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id])
  customerId             String
  campaignId             String       @default(uuid()) @unique
  googleAdsCampaignId    String?
  name                   String
  status                 String       @default("PAUSED")
  campaignType           String?      @default("SEARCH")
  biddingStrategy        String?
  budget                 Float?
  budgetResourceName     String?
  startDate              DateTime?
  endDate                DateTime?
  headlines              Json?
  descriptions           Json?
  finalUrl               String?
  keywords               Json?
  geoTargets             Json?
  advertisingChannelType String       @default("SEARCH")
  amountMicros           BigInt       @default(0)
  impressions            BigInt       @default(0)
  clicks                 BigInt       @default(0)
  costMicros             BigInt       @default(0)
  conversions            Float        @default(0.0)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
}

model GoogleAdGroup {
  id               String   @id @default(uuid())
  organizationId   String
  customerId       String
  campaignId       String
  adGroupId        String   @default(uuid()) @unique
  googleAdGroupId  String?  @unique
  googleCampaignId String?
  name             String
  adGroupType      String?  @default("SEARCH_STANDARD")
  status           String   @default("ENABLED")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model GoogleAd {
  id              String   @id @default(uuid())
  organizationId  String
  customerId      String
  adGroupId       String
  adId            String   @default(uuid()) @unique
  googleAdId      String?
  googleAdGroupId String?
  headlines       Json?
  descriptions    Json?
  finalUrls       Json?
  path1           String?
  path2           String?
  status          String   @default("ENABLED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GoogleAdKeyword {
  id              String   @id @default(uuid())
  organizationId  String
  customerId      String
  adGroupId       String?
  googleAdGroupId String?
  keywordId       String   @default(uuid()) @unique
  googleKeywordId String?
  text            String
  matchType       String   @default("EXACT")
  isNegative      Boolean  @default(false)
  status          String   @default("ENABLED")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GmailBulkCampaign {
  id              String                   @id @default(uuid())
  organizationId  String
  name            String
  subject         String
  bodyTemplate    String
  status          String                   @default("DRAFT")
  scheduledAt     DateTime?
  totalRecipients Int                      @default(0)
  sentCount       Int                      @default(0)
  failedCount     Int                      @default(0)
  skippedCount    Int                      @default(0)
  delaySeconds    Int                      @default(3)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  recipients      GmailCampaignRecipient[]

  @@map("gmail_bulk_campaigns")
}

model GmailCampaignRecipient {
  id           String            @id @default(uuid())
  campaignId   String
  campaign     GmailBulkCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email        String
  name         String?
  company      String?
  designation  String?
  customData   String?
  status       String            @default("PENDING")
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime          @default(now())

  @@map("gmail_campaign_recipients")
}

model GmailEmailTemplate {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  subject        String
  body           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("gmail_email_templates")
}

// ─── AI Agent Studio & Knowledge Base Training System ──────────────────────
model AiAgentConfig {
  id                 String       @id @default(uuid())
  organizationId     String       @unique
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentName          String       @default("AI Sales Specialist")
  personalityPrompt  String       @default("You are a warm, highly knowledgeable, human-like sales and customer support representative. Chat naturally in a friendly, conversational tone. Understand customer requirements, answer questions based strictly on trained company data, attach relevant portfolio screenshots or PDFs when requested, and collect contact details if they ask to be called back.")
  greetingMessage    String?      @default("Hello! How can I assist you with our services today?")
  activeMode         String       @default("AI_AGENT")
